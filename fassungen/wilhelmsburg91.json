{"name":"Wilhelmsburg 91","festgestellt":"09.12.2024","recht":"Verordnung über den Bebauungsplan Wilhelmsburg 91 vom 9. Dezember 2024 (HmbGVBl. Nr. 3 vom 21.01.2025), BauNVO Fassung 21.11.2017","auto":true,"grzDefaults":null,"grzDefaultsNote":"","warnings":[{"text":"Gebäudehöhen (GH) sind Höhen über NHN, nicht über Gelände.","src":"Legende 03.jpg"},{"text":"GH mit Kreis ist zwingend; ohne Kreis Höchstmaß. Bei Angaben wie 18-25 gilt Mindest- und Höchstmaß.","src":"Legende 03.jpg"},{"text":"Römische Zahl mit Strich (z. B. IV-V) bedeutet Mindest- und Höchstzahl der Vollgeschosse.","src":"Legende 03.jpg"},{"text":"Die Plankarte ist sehr dicht beschriftet. Einzelne Baufeld-Beschriftungen sind nur teilweise zuordenbar; bitte Originalplan prüfen.","src":"01.jpg, 04.jpg, 05.jpg, 07.jpg"},{"text":"Die Wohnnutzung in den (ZZ)- und (Z)-Bereichen ist erst nach Fertigstellung der (D)- bzw. (E)-Bebauung zulässig.","src":"§ 2 Nr. 23, 24"}],"zones":[{"id":"Z1","lage":"MU 1, Block nordwestlich Planstraße A (MU VII GRZ 0,45)","flst":[],"art":"MU","vg":7,"vgArt":"höchstens","grz":0.45,"gfz":null,"bauweise":"geschlossen","hoehe":"GH 27 (über NHN)","src":"automatisch aus dem Originalplan gelesen"},{"id":"Z2","lage":"MU 1, Block (MU IV GRZ 0,6)","flst":[],"art":"MU","vg":4,"vgArt":"höchstens","grz":0.6,"gfz":null,"bauweise":"geschlossen","hoehe":"GH 18 (über NHN)","src":"automatisch aus dem Originalplan gelesen"},{"id":"Z3","lage":"MU 1, Block (MU I GRZ 0,75)","flst":[],"art":"MU","vg":1,"vgArt":"höchstens","grz":0.75,"gfz":null,"bauweise":"geschlossen","hoehe":"GH 9 (über NHN)","src":"automatisch aus dem Originalplan gelesen"},{"id":"Z4","lage":"MU 1, Block (MU IV GRZ 0,75)","flst":[],"art":"MU","vg":4,"vgArt":"höchstens","grz":0.75,"gfz":null,"bauweise":"geschlossen","hoehe":"GH 18 (über NHN)","src":"automatisch aus dem Originalplan gelesen"},{"id":"Z5","lage":"MU 1, Block (MU VI GRZ 0,75)","flst":[],"art":"MU","vg":6,"vgArt":"höchstens","grz":0.75,"gfz":null,"bauweise":"geschlossen","